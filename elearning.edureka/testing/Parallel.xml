<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Edureka Parallel Suite" parallel="tests" thread-count="2">

    <!-- Chrome Execution -->
    <test name="Chrome Test">
        <parameter name="browser" value="chrome"/>

        <classes>
			<class name="Batch.ArtificialIntelligenceTest"></class>
			<class name="Batch.AllCoursesTest"></class>
        </classes>
    </test>

    <!-- Firefox Execution -->
    <test name="Edge Test">
        <parameter name="browser" value="edge"/>

        <classes>
			<class name="Batch.ArtificialIntelligenceTest"></class>
			<class name="Batch.AllCoursesTest"></class>
        </classes>
    </test>

</suite>
