<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Edureka Cross Browser Suite">

	<!-- Chrome Execution -->
    <test name="Chrome Test">
        <parameter name="browser" value="chrome"/>
        <classes>
        	<class name="elearning.edureka.login.LoginTest"></class>
        </classes>
    </test>
 
    <!-- Edge Execution -->
    <test name="Edge Test">
        <parameter name="browser" value="edge"/>
		<classes>
        	<class name="elearning.edureka.allCourses.AllCoursesTest"></class>
        </classes>
    </test>
    
    <!-- Firefox Execution -->
    <test name="Firefox Test">
        <parameter name="browser" value="firefox"/>
		<classes>
        	<class name="elearning.edureka.categories.ArtificialIntelligenceTest"></class>
        </classes>
    </test>
    

</suite>
